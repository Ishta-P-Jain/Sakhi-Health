# Sakhi backend environment variables. Copy to .env and fill in secrets.
# Never commit .env or real keys to version control.

# LLM (Ollama) - chat requires Ollama to be running and the model to be available
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:120b-cloud

# CORS - comma-separated origins the frontend is served from
CORS_ORIGINS=http://localhost:5173

# Geocoder (Nominatim) - set a descriptive user agent with contact info
GEOCODER_USER_AGENT=sakhi-hackathon/0.1 (contact: you@example.com)
GEOCODE_COUNTRY=in

# Rate limiting
CHAT_RATE_LIMIT_PER_MINUTE=20

# Database: default SQLite (sakhi.db). For PostgreSQL set e.g.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/sakhi
DATABASE_URL=sqlite:///./sakhi.db

# Auth / JWT - CHANGE THESE in production; never commit real values
SECRET_KEY=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File storage for medical reports (outside public static dirs)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
